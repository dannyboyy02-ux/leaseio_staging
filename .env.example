# LeaseIO — environment variables
#
# Copy this file to `.env` (gitignored) for the frontend, and set the
# Supabase Edge Function secrets via the Supabase dashboard or
# `supabase secrets set`. Never commit real values.
#
# Audited and rebuilt 2026-05-07 from a full grep of:
#   - Frontend:    `import.meta.env.VITE_*` references in `src/`
#   - Edge funcs:  `Deno.env.get(...)` references in `supabase/functions/`
#
# If you add a new env var anywhere, add a documented entry below.

# ─────────────────────────────────────────────────────────────────────
# Frontend (Vite — embedded into the bundle at build time)
# ─────────────────────────────────────────────────────────────────────

# Supabase project URL. Found in Supabase dashboard → Settings → API.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon key. Used by the supabase-js browser client. Safe to
# expose; RLS policies enforce tenant isolation.
# (The codebase reads BOTH `VITE_SUPABASE_ANON_KEY` and
# `VITE_SUPABASE_PUBLISHABLE_KEY` — both should be set to the same anon
# key value. Lovable's auto-generated client uses the latter name; some
# hand-written code uses the former. Setting both removes ambiguity.)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ─────────────────────────────────────────────────────────────────────
# Edge function secrets (server-side; set via Supabase dashboard or
# `supabase secrets set`. NEVER commit real values to .env.)
# ─────────────────────────────────────────────────────────────────────
#
# Listed for documentation only — these are NOT loaded from this file
# at runtime. Set them in the Supabase project's Edge Function secrets
# console:
#   https://supabase.com/dashboard/project/<ref>/settings/functions

# === Supabase platform (auto-injected into edge runtime — do NOT set manually) ===
# SUPABASE_URL                     # auto-injected
# SUPABASE_ANON_KEY                # auto-injected
# SUPABASE_SERVICE_ROLE_KEY        # auto-injected; bypasses RLS

# === Anthropic API (Claude — used by ai-assistant + future Phase 8 extraction) ===
# ANTHROPIC_API_KEY                # sk-ant-... — required by ai-assistant

# === Azure Document Intelligence (current OCR pipeline for process_lease) ===
# AZURE_DI_ENDPOINT                # https://<region>.cognitiveservices.azure.com
# AZURE_DI_KEY                     # primary key from Azure portal
# AZURE_DI_MODEL                   # default: prebuilt-layout

# === Resend (transactional email) ===
# RESEND_API_KEY                   # re_... — required for all email-sending functions
# RESEND_FROM_EMAIL                # default sender, e.g. "LeaseIO <noreply@theleaseio.com>"
# RESEND_INVITES_FROM_EMAIL        # invite-flow sender (falls back to RESEND_FROM_EMAIL)
# RESEND_APPROVALS_FROM_EMAIL      # approval-notification sender
# RESEND_ALERTS_FROM_EMAIL         # alert / nudge sender

# === Stripe (subscriptions) ===
# STRIPE_SECRET_KEY                # sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET            # whsec_... — verifies webhook signatures
# STRIPE_PRICE_STARTER_ANNUAL      # price_... — annual recurring Price for the
#                                  # Starter Product. Required for annual checkout
#                                  # to work; create-checkout fails closed (503,
#                                  # reason 'annual_not_configured') without it.
# STRIPE_PRICE_BUSINESS_ANNUAL     # price_... — annual recurring Price for the
#                                  # Business Product. Same fail-closed behavior.
# STRIPE_PRICE_VAULT_ANNUAL        # price_... — yearly recurring Price for the
#                                  # Vault retention tier ($249/yr; VAULT_TIER_SPEC.md).
#                                  # Webhook recognizes Vault subs via metadata even
#                                  # without it; the V3 conversion checkout fails
#                                  # closed (503) when unset.
# STRIPE_PRICE_PACK_10             # price_... — recurring monthly Price for the
#                                  # 10-lease document pack ($90/mo). Required for
#                                  # pack purchase; manage-document-pack fails
#                                  # closed (reason 'pack_not_configured') without it.
# STRIPE_PRICE_PACK_20             # price_... — 20-lease pack ($160/mo). Same.
# STRIPE_PRICE_PACK_50             # price_... — 50-lease pack ($350/mo). Same.

# === App routing (used in email links + redirect targets) ===
# APP_URL                          # https://app.theleaseio.com  (or your equivalent)
# SITE_URL                         # https://theleaseio.com      (marketing / public share base)

# === Cron secrets (shared-secret auth for non-JWT cron calls) ===
# LEASE_NOTIFICATIONS_CRON_SECRET  # 32+ char random; checked by send-lease-notifications
#                                  # against the x-cron-secret header
# NOTIFICATION_DISPATCH_CRON_SECRET # 32+ char random; checked by dispatch-notifications
#                                  # (#109 — delivers approval-notification emails)
# CLEANUP_EXPIRED_REPORTS_CRON_SECRET
#                                  # 32+ char random; checked by cleanup-expired-reports.
#                                  # Must ALSO be set as a Postgres database setting so
#                                  # pg_cron forwards it as the x-cron-secret header:
#                                  #   ALTER DATABASE postgres SET
#                                  #     app.cleanup_expired_reports_cron_secret = '<value>';
# SEND_COUNTER_SIGNATURE_REMINDER_CRON_SECRET
#                                  # 32+ char random; checked by send-counter-signature-reminder.
#                                  # Pair: ALTER DATABASE postgres SET
#                                  #     app.send_counter_signature_reminder_cron_secret = '<value>';
# PROCESS_DELEGATE_TIMERS_CRON_SECRET
#                                  # 32+ char random; checked by process-delegate-timers.
#                                  # Pair: ALTER DATABASE postgres SET
#                                  #     app.process_delegate_timers_cron_secret = '<value>';
# DETECT_STUCK_CHAINS_CRON_SECRET
#                                  # 32+ char random; checked by detect-stuck-chains.
#                                  # Pair: ALTER DATABASE postgres SET
#                                  #     app.detect_stuck_chains_cron_secret = '<value>';
# VENDOR_HEALTH_CHECK_CRON_SECRET
#                                  # 32+ char random; checked by vendor-health-check.
#                                  # Pair: INSERT INTO private.cron_secrets
#                                  #     (id, value) VALUES ('vendor_health_check', '<value>');
# RECLAIM_STUCK_EXTRACTIONS_CRON_SECRET
#                                  # 32+ char random; checked by reclaim-stuck-extractions
#                                  # (Cluster B2 — fails leases stuck in status='Processing'
#                                  # past 30 min; runs every 15 min via pg_cron).
#                                  # Pair: INSERT INTO private.cron_secrets
#                                  #     (id, value) VALUES ('reclaim_stuck_extractions', '<value>');
# SWEEP_PENDING_WORKSPACES_CRON_SECRET
#                                  # 32+ char random; checked by sweep-pending-workspaces
#                                  # (deletes abandoned pending multi-workspace creations).
# VITE_STRIPE_PUBLISHABLE_KEY      # Client-side Stripe publishable key (pk_test_… in
#                                  # staging/dev, pk_live_… in production). Used by
#                                  # @stripe/stripe-js for in-app 3DS confirmation in the
#                                  # multi-workspace create flow. The lib asserts the
#                                  # prefix matches MODE — pk_live_ in production, pk_test_
#                                  # elsewhere — so a mismatched key fails closed.
# VITE_STRIPE_KEY_MODE             # 'test' | 'live' — EXPLICIT declaration of this deploy's
#                                  # Stripe mode, overriding the build-mode inference above.
#                                  # Set 'test' (with a pk_test_ key) on the production
#                                  # domain while the whole backend runs test-mode Stripe
#                                  # (pre-launch); at live cutover swap the key AND this
#                                  # var together — either half alone fails closed.

# === Operational Monitoring adapter tokens (Phase 2 of OPERATIONAL_MONITORING_SPEC.md) ===
# RESEND_API_KEY                   # already set above for outbound email; reused by
#                                  # the Resend monitoring adapter for usage polling
# MANAGEMENT_API_TOKEN             # https://supabase.com/dashboard/account/tokens
#                                  # read-only personal access token for the
#                                  # Supabase Management API. Required for the
#                                  # Supabase monitoring adapter (db_size,
#                                  # storage, egress, edge_invocations, MAU).
#                                  # NOTE: NOT named SUPABASE_MANAGEMENT_TOKEN
#                                  # because the SUPABASE_ prefix is reserved
#                                  # by the edge function platform for
#                                  # auto-injected secrets; user-set secrets
#                                  # with that prefix are silently refused.
# PROJECT_REF                      # default: wwkwoxxcprnjjufkbzac (auto in code)
# VERCEL_ACCESS_TOKEN              # https://vercel.com/account/tokens
#                                  # read-only personal access token. Required
#                                  # for the Vercel monitoring adapter
#                                  # (bandwidth, function_invocations, build_minutes).
# VERCEL_TEAM_ID                   # only if Vercel project lives under a team account

# === Operational Monitoring Phase 3 adapter tokens ===
# SENTRY_AUTH_TOKEN                # https://sentry.io/settings/account/api/auth-tokens/
#                                  # scopes: org:read, project:read
# SENTRY_ORG_SLUG                  # e.g. 'leaseio'
# ANTHROPIC_ADMIN_API_KEY          # https://console.anthropic.com/settings/keys
#                                  # admin key with Organization Reports scope
#                                  # (DISTINCT from runtime ANTHROPIC_API_KEY)
# ANTHROPIC_MONTHLY_CAP_USD        # value matching the cap configured in
#                                  # the Anthropic Console (Phase 1 deliverable).
#                                  # When unset, spend snapshots have no
#                                  # threshold but burn-rate alerts still fire
#                                  # against the 7-day rolling average.
# STRIPE_SECRET_KEY                # already set above; reused by Stripe
#                                  # webhook health adapter (needs read scope
#                                  # on /v1/events and /v1/webhook_endpoints)

# ─────────────────────────────────────────────────────────────────────
# Quick sanity check after setting these
# ─────────────────────────────────────────────────────────────────────
#
#   1. Frontend: `npm run dev` and verify no console error like
#      "Missing VITE_SUPABASE_URL" on first load.
#
#   2. Edge functions: invoke any one (e.g.
#      `curl -X OPTIONS https://<ref>.supabase.co/functions/v1/check-subscription`)
#      and confirm a 200 — a "Server configuration error" 500 means a
#      required env var is unset on the function side.
#
#   3. Stripe: trigger a test webhook from the Stripe dashboard. The
#      stripe-webhook function must return 200; a 401 means the
#      STRIPE_WEBHOOK_SECRET is wrong or missing.

# Cancellation lifecycle cron (process-cancellation-lifecycle) — shared
# secret the scheduler sends as x-cron-secret. Generate with `openssl rand -hex 32`.
CANCELLATION_LIFECYCLE_CRON_SECRET=
# VAULT_RENEWAL_CRON_SECRET       # shared secret for the vault-renewal-reminder cron
# FIRM_BILLING_CRON_SECRET        # 32+ char random; checked by firm-billing-reconcile (x-cron-secret) — #107
# LEASE_RETENTION_CRON_SECRET     # 32+ char random; checked by process-lease-retention (x-cron-secret).
#                                  # Pair: INSERT INTO private.cron_secrets (id,value) VALUES ('lease_retention','<value>')
# AUTO_NUDGE_CRON_SECRET          # 32+ char random; checked by auto-nudge-approvers (x-cron-secret) — P1-6 day-2/5/10 escalation.
#                                  # Pair: INSERT INTO private.cron_secrets (id,value) VALUES ('auto_nudge','<value>')
#                                  # Operator-gated (Phase 3 lease soft-delete/14-day purge) — cron is inert until set.
